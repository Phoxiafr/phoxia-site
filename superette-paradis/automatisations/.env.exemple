# Copier ce fichier en .env puis remplir. Ne jamais partager le fichier .env.

# 1. Publications Instagram + Facebook (Meta, gratuit)
SITE_URL=https://superette-paradis.netlify.app
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ID=

# 2. Réponses aux avis Google
#    Sans clé Anthropic : réponses types gratuites. Avec : réponses personnalisées par Claude.
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

# 3. Assistant WhatsApp (WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=un-mot-de-passe-au-choix
META_APP_SECRET=
PORT=3000
